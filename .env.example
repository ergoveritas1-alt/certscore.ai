# Reference template for the monorepo.
# For local development, prefer:
# - apps/web/.env.local
# Production values should live only in the deployment platform env settings.

# Shared
NODE_ENV=development

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/certscore
DATABASE_READ_URL=
DATABASE_SSL_MODE=disable
GMAIL_SMTP_USER=you@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-gmail-app-password
FEEDBACK_TO_EMAIL=ben@ergoveritas.com
OPENAI_API_KEY=

# Worker
WORKER_CONCURRENCY=2
REDIS_URL=redis://127.0.0.1:6379
RAILWAY_STATIC_URL=worker.example.up.railway.app
PLAYWRIGHT_BROWSERS_PATH=0

# Reports / storage
S3_BUCKET=scan-artifacts
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
