# Reference template for the monorepo.
# For local development, prefer:
# - apps/web/.env.local
# Production values should live only in the deployment platform env settings.

# Shared
NODE_ENV=development
SCAN_ARTIFACTS_ENABLED=false
SCAN_ARTIFACT_RETENTION_DAYS=3
SCAN_ARTIFACT_MAX_MB=250

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/certscore
DATABASE_READ_URL=
DATABASE_SSL_MODE=disable
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_SMTP_USER=you@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-gmail-app-password
FEEDBACK_TO_EMAIL=team@example.com
OPS_ALERT_TO_EMAIL=ops@example.com
OPENAI_API_KEY=

# Worker
WORKER_CONCURRENCY=1
VALIDATION_PIPELINE_ENABLED=1
VALIDATION_SCHEDULER_POLL_MINUTES=1
VALIDATION_DEFAULT_RUN_MODE=manual
VALIDATION_DEFAULT_SAMPLE_INTERVAL_MINUTES=20
VALIDATION_OPENAI_MODEL=gpt-5.4-nano
VALIDATION_NANO_MODEL=gpt-5.4-nano
CERTSCORE_EXTRACTION_MODEL=gpt-5.4-nano
CERTSCORE_REVIEW_MODEL=gpt-5.4-mini
CERTSCORE_ESCALATION_MODEL=
CERTSCORE_MINI_REVIEW_ENABLED=0
CERTSCORE_ESCALATION_ENABLED=0
CERTSCORE_MODEL_REVIEW_MODE=shadow
WEB_BOT_AUTH_ENABLED=0
WEB_BOT_AUTH_PRIVATE_KEY_PEM=
WEB_BOT_AUTH_SIGNATURE_AGENT_URL=
WEB_BOT_AUTH_EXPIRES_SECONDS=300
WEB_BOT_AUTH_INCLUDE_NONCE=0
PLAYWRIGHT_BROWSERS_PATH=

# Reports / storage
S3_BUCKET=scan-artifacts
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
