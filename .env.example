# Reference template for the monorepo.
# For local development, prefer:
# - apps/web/.env.local
# - apps/worker/.env.local
# Production values should live only in the deployment platform env settings.

# Shared
NODE_ENV=development

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GMAIL_SMTP_USER=you@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-gmail-app-password
FEEDBACK_TO_EMAIL=ben@ergoveritas.com
OPENAI_API_KEY=

# Worker
WORKER_CONCURRENCY=2
REDIS_URL=redis://127.0.0.1:6379
RAILWAY_STATIC_URL=worker.example.up.railway.app
PLAYWRIGHT_BROWSERS_PATH=0

# Reports / storage
SUPABASE_STORAGE_BUCKET=scan-reports
SUPABASE_STORAGE_BUCKET_SCREENSHOTS=scan-screenshots
SUPABASE_STORAGE_BUCKET_ARTIFACTS=scan-artifacts
