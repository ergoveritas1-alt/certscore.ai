{
  "manifest_version": 3,
  "name": "CertScore.ai Browser Evidence",
  "description": "Run browser-assisted CertScore.ai scans with pre-consent, privacy-surface, transport, embed, and accessibility evidence.",
  "version": "0.2.0",
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    "default_popup": "src/popup.html",
    "default_title": "CertScore.ai Browser Evidence"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://certscore.ai/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "host_permissions": ["https://certscore.ai/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "permissions": ["browsingData", "cookies", "scripting", "storage", "tabs", "webRequest", "windows"]
}
