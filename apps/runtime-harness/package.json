{
  "name": "@website-signal-risk-scanner/runtime-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "batch": "npx -y node@22 --enable-source-maps --import tsx ./src/batch.ts",
    "build": "tsc -p tsconfig.json",
    "check": "pnpm check:hybrid-auto-decision",
    "check:hybrid-auto-decision": "npx -y node@22 --enable-source-maps --import tsx ./src/check-hybrid-auto-decision.ts",
    "merge": "npx -y node@22 --enable-source-maps --import tsx ./src/merge.ts",
    "scan": "npx -y node@22 --enable-source-maps --import tsx ./src/cli.ts",
    "test": "sh -c 'node --import tsx --test $(find src -name \"*.test.ts\" | sort)'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm verify:hybrid-auto-decision",
    "verify:hybrid-auto-decision": "pnpm typecheck && pnpm test && pnpm check:hybrid-auto-decision",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "playwright": "^1.51.1",
    "selenium-webdriver": "^4.30.0"
  },
  "devDependencies": {
    "@types/selenium-webdriver": "^4.1.28"
  }
}
