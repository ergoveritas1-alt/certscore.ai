{
  "name": "@website-signal-risk-scanner/scanner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-env": "npx -y node@22 --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/check-scanner-env.ts",
    "check-runtime": "npx -y node@22 --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/check-scanner-runtime.ts",
    "dev": "npx -y node@22 --env-file=../web/.env.local --enable-source-maps --import tsx --watch ./src/index.ts",
    "start": "node --enable-source-maps ./dist/apps/scanner/src/index.js",
    "start:scheduler": "node --enable-source-maps ./dist/apps/scanner/src/scheduling/run-scheduler.js",
    "scheduler": "npx -y node@22 --env-file=../web/.env.local --enable-source-maps --import tsx ./src/scheduling/run-scheduler.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@website-signal-risk-scanner/db": "workspace:*",
    "@website-signal-risk-scanner/scan-core": "workspace:*",
    "@website-signal-risk-scanner/shared": "workspace:*",
    "playwright": "^1.51.1",
    "zod": "^3.24.2"
  }
}
