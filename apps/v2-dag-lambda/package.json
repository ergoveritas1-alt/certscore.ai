{
  "name": "@website-signal-risk-scanner/v2-dag-lambda",
  "version": "0.1.0",
  "private": true,
  "description": "Dev/local Lambda wrapper for CertScore v2 DAG artifact-only scans.",
  "main": "./dist/src/handler.js",
  "types": "./dist/src/handler.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-bundle/src/handler.js --external:playwright --external:pdf-parse --minify --tsconfig=../../tsconfig.base.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "clean": "rm -rf dist dist-bundle"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1069.0",
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/client-sqs": "^3.1069.0",
    "@certscore/contracts": "workspace:*",
    "@certscore/scan-core": "workspace:*",
    "@website-signal-risk-scanner/shared": "workspace:*",
    "pdf-parse": "^2.4.5"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-linux-x64-gnu": "0.1.80"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "@types/node": "^24.0.0"
  }
}
