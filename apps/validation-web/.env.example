NODE_ENV=development

# Validation web app runs on a separate localhost port in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3001
APP_FLAVOR=validation_ops

# Use the same dev Supabase project as the main app unless you intentionally isolate it.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-supabase-service-role-key

# Validation web queue isolation.
VALIDATION_REDIS_URL=redis://127.0.0.1:6380

# Optional auth and operator access controls.
CERTSCORE_ADMIN_EMAILS=you@example.com
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
