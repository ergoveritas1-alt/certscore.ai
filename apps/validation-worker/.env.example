NODE_ENV=development
SCAN_ARTIFACTS_ENABLED=false
SCAN_ARTIFACT_RETENTION_DAYS=3
SCAN_ARTIFACT_MAX_MB=250

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/certscore
DATABASE_READ_URL=
DATABASE_SSL_MODE=disable

OPENAI_API_KEY=
VALIDATION_PIPELINE_ENABLED=1
VALIDATION_SCHEDULER_POLL_MINUTES=1
VALIDATION_DEFAULT_RUN_MODE=manual
VALIDATION_DEFAULT_SAMPLE_INTERVAL_MINUTES=20
VALIDATION_OPENAI_MODEL=gpt-5.4-nano
VALIDATION_NANO_MODEL=gpt-5.4-nano
VALIDATION_TRANCO_MIN_RANK=1000
VALIDATION_TRANCO_MAX_RANK=100000
VALIDATION_TRANCO_SOURCE_URL=
WEB_BOT_AUTH_ENABLED=0
WEB_BOT_AUTH_PRIVATE_KEY_PEM=
WEB_BOT_AUTH_SIGNATURE_AGENT_URL=
WEB_BOT_AUTH_EXPIRES_SECONDS=300
WEB_BOT_AUTH_INCLUDE_NONCE=0
SCANNER_CRAWLER_NAME=ValidationOpsCrawler
SCANNER_CRAWLER_PUBLIC_URL=
VALIDATION_CRAWLER_PUBLIC_URL=
PLAYWRIGHT_BROWSERS_PATH=
WORKER_BROWSER_REAPER_ENABLED=1
WORKER_BROWSER_REAPER_INTERVAL_MINUTES=5
WORKER_BROWSER_REAPER_STALE_MINUTES=20
WORKER_CONCURRENCY=1

# Optional v2 Lambda result ingestion. Set target env to local for localhost return paths
# and production for live return paths. Regional queue vars are polled together.
CERTSCORE_V2_DAG_LAMBDA_RESULT_POLL_ENABLED=1
CERTSCORE_V2_DAG_LAMBDA_RESULT_POLL_SECONDS=2
CERTSCORE_V2_DAG_LAMBDA_TARGET_ENV=local
# CERTSCORE_V2_DAG_LAMBDA_EU_DE_RESULT_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/account/certscore-v2-dag-de-results
# CERTSCORE_V2_DAG_LAMBDA_EU_IE_RESULT_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/account/certscore-v2-dag-ie-results
# CERTSCORE_V2_DAG_LAMBDA_US_WEST_RESULT_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/account/certscore-v2-dag-usw-results
