{
  "name": "@website-signal-risk-scanner/validation-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit:live-consent": "node --enable-source-maps --import tsx ./scripts/live-consent-audit.ts",
    "backfill:preconsent-evidence-urls": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/backfill-preconsent-evidence-urls.ts",
    "backfill:nano-signals": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/backfill-nano-signal-populations.ts",
    "build": "tsc -p tsconfig.json",
    "check-env": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/check-validation-env.ts",
    "check-runtime": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/check-validation-runtime.ts",
    "dev": "node --env-file=../web/.env.local --enable-source-maps --import tsx --watch ./src/index.ts",
    "evaluate:policy-review": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/evaluate-model-policy-review.ts",
    "benchmark:nano-policy-review": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/run-policy-review-benchmark.ts --model gpt-5.4-nano --lane gpt-5.4-nano-routing-v1 --resume",
    "benchmark:mini-escalation-policy-review": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/run-policy-review-escalation-benchmark.ts --resume",
    "benchmark:dual-nano-policy-review": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/run-policy-review-dual-nano-benchmark.ts --resume",
    "gate:mini-escalation-policy-review": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/evaluate-model-policy-review.ts --review-kind policy_semantic_hybrid_shadow --artifact-dir artifacts/policy-review-model-benchmark-v1/gpt-5.4-mini-bounded-escalation-v1 --strict",
    "gate:dual-nano-policy-review": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/evaluate-model-policy-review.ts --review-kind policy_semantic_dual_nano_shadow --artifact-dir artifacts/policy-review-model-benchmark-v1/gpt-5.4-dual-nano-consensus-v1 --strict",
    "gate:nano-policy-review": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/evaluate-model-policy-review.ts --review-kind policy_semantic_nano_shadow --artifact-dir artifacts/policy-review-model-benchmark-v1/gpt-5.4-nano-routing-v1 --strict",
    "extract:financial-claims-drafts": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/extract-financial-claims-drafts.ts",
    "extract:privacy-runtime-drafts": "node --enable-source-maps --import tsx ./scripts/extract-privacy-runtime-drafts.ts",
    "inspect:signal-enrichment": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/inspect-signal-enrichment.ts",
    "ingest:policy-review": "node --enable-source-maps --import tsx ./scripts/ingest-independent-policy-review.ts",
    "promote:policy-review-adjudication": "node --enable-source-maps --import tsx ./scripts/promote-human-adjudicated-policy-review.ts",
    "ops:prod-db-audit": "node --enable-source-maps ./dist/apps/validation-worker/scripts/prod-db-audit.js",
    "ops:prod-preconsent-rerun": "node --enable-source-maps ./dist/apps/validation-worker/scripts/prod-preconsent-rerun.js",
    "ops:nano-signal-backfill": "node --enable-source-maps ./dist/apps/validation-worker/scripts/nano-signal-backfill.js",
    "ops:prod-db-probe": "node --enable-source-maps ./dist/apps/validation-worker/scripts/prod-ops-db-probe.js",
    "ops:static-tranco-import": "node --enable-source-maps ./dist/apps/validation-worker/scripts/import-static-tranco-snapshot.js",
    "prepare:policy-review": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/prepare-independent-policy-review.ts",
    "summarize:signal-events": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/inspect-signal-enrichment.ts --events-only",
    "summarize:signal-enrichment": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/inspect-signal-enrichment.ts --summary",
    "score:financial-homepage-confidence": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/score-financial-homepage-confidence.ts",
    "gate:policy-review": "pnpm evaluate:policy-review -- --strict",
    "shadow:policy-review": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/run-model-policy-shadow.ts",
    "list:degraded-body-retries": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/list-degraded-body-retry-candidates.ts",
    "smoke:validation:financial": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/run-financial-validation-smoke.ts",
    "smoke:validation": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/run-validation-smoke.ts",
    "smoke:validation:fresh": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/run-validation-fresh-smoke.ts",
    "start": "node --enable-source-maps ./dist/apps/validation-worker/src/index.js",
    "start:scheduler": "node --enable-source-maps ./dist/apps/validation-worker/src/validation/run-scheduler.js",
    "scheduler": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./src/validation/run-scheduler.ts --once",
    "test:scan-pipeline": "node --enable-source-maps --import tsx --test ./src/validation/pipeline.test.ts ./src/validation/model-policy-review.test.ts ./src/validation/model-policy-review-runner.test.ts ./src/validation/policy-review-routing.test.ts ./src/validation/policy-review-escalation.test.ts ./src/validation/policy-review-consensus.test.ts ./src/validation/canonical-policy-review-input.test.ts ./src/validation/model-review-evaluation.test.ts ./src/validation/model-review-gold-corpus.test.ts ./src/validation/model-review-independent-review.test.ts ./src/validation/model-routing.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@axe-core/playwright": "4.11.2",
    "@aws-sdk/client-s3": "3.1069.0",
    "@aws-sdk/client-sqs": "3.1069.0",
    "@certscore/api-contracts": "workspace:*",
    "@certscore/contracts": "workspace:*",
    "@certscore/scan-core": "workspace:*",
    "@certscore/vendor-resolver": "workspace:*",
    "@website-signal-risk-scanner/db": "workspace:*",
    "@website-signal-risk-scanner/shared": "workspace:*",
    "@website-signal-risk-scanner/validation-shared": "workspace:*",
    "@website-signal-risk-scanner/web-bot-auth": "workspace:*",
    "playwright": "1.58.2",
    "tldts": "^7.4.2",
    "zod": "3.25.76"
  }
}
