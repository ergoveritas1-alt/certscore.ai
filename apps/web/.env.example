NODE_ENV=development
SCAN_ARTIFACTS_ENABLED=false
SCAN_ARTIFACT_RETENTION_DAYS=3
SCAN_ARTIFACT_MAX_MB=250

# Local web app URL. Keep this pointed at localhost for dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_FLAVOR=certscore
VALIDATION_OPS_BASE_URL=

# Use a standard PostgreSQL database for local auth and data.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/certscore
DATABASE_READ_URL=
DATABASE_SSL_MODE=disable

# Optional auth toggle for the login screen.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_ULTRA_CHECKOUT_URL=
CERTSCORE_CHROME_EXTENSION_STORE_URL=https://chrome.google.com/webstore/detail/fopkldkmhadjkoafdgemginpkgonfmga

# Temporary access gates. Defaults in code currently restrict app access to this
# list, pause public account creation, and pause self-serve checkout.
CERTSCORE_AUTH_ACCESS_RESTRICTED=false
CERTSCORE_AUTH_ALLOWED_EMAILS=ben@certscore.ai,bmasek@gmail.com,demo@certscore.ai,xlprep@gmail.com,mcp_demo@certscore.ai
CERTSCORE_PUBLIC_ACCOUNT_CREATION_ENABLED=true
CERTSCORE_SELF_SERVE_PURCHASING_ENABLED=true

# Stripe billing. Create monthly subscription prices for Starter and Pro in Stripe,
# then paste the price IDs here. Webhooks should point to /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
STRIPE_BILLING_PORTAL_RETURN_PATH=/app/modify-plan

# Shared platform integrations used by the web app.
S3_BUCKET=scan-artifacts
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Optional app features.
FULL_SCAN_ALLOW_PRODUCTION_LOAD_TEST_DNS_BYPASS=false
# Customer GDPR/ePrivacy score selector. The posture candidate is now the
# default customer-facing score. Set `legacy` only for an explicit rollback.
CERTSCORE_GDPR_EPRIVACY_SCORE_MODE=approved_candidate
# Local/dev safety: leave false unless WS01 has residential proxy credentials configured.
FULL_SCAN_RESIDENTIAL_GEO_ENABLED=false
# Local/dev only: when running NEXT_PUBLIC_APP_URL on localhost, route non-admin full scans to the local WS01 queue instead of Lambda.
CERTSCORE_LOCALHOST_FULL_SCAN_QUEUE_ENABLED=false
NEXT_PUBLIC_CERTSCORE_LOCALHOST_FULL_SCAN_QUEUE_ENABLED=false

# Hosted MCP OAuth issuer/resource configuration. Keep the signing secret in Secrets Manager in production.
OAUTH_ISSUER=https://certscore.ai
MCP_PUBLIC_URL=https://mcp.certscore.ai
# CERTSCORE_OAUTH_JWT_SECRET=replace-with-a-long-random-secret

# Optional v2 Lambda scan dispatch. Use regional vars when enabling multiple Lambda locations.
# CERTSCORE_V2_DAG_LAMBDA_TARGET_ENV=local
# CERTSCORE_V2_DAG_LAMBDA_ORCHESTRATION_MODE=sharded
# CERTSCORE_V2_DAG_LAMBDA_EU_DE_ENABLED=true
# CERTSCORE_V2_DAG_LAMBDA_EU_DE_FUNCTION_NAME=certscore-v2-dag-de
# CERTSCORE_V2_DAG_LAMBDA_EU_DE_RESULT_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/account/certscore-v2-dag-de-results
# CERTSCORE_V2_DAG_LAMBDA_EU_IE_ENABLED=true
# CERTSCORE_V2_DAG_LAMBDA_EU_IE_FUNCTION_NAME=certscore-v2-dag-ie
# CERTSCORE_V2_DAG_LAMBDA_EU_IE_RESULT_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/account/certscore-v2-dag-ie-results
# CERTSCORE_V2_DAG_LAMBDA_US_WEST_ENABLED=true
# CERTSCORE_V2_DAG_LAMBDA_US_WEST_FUNCTION_NAME=certscore-v2-dag-usw
# CERTSCORE_V2_DAG_LAMBDA_US_WEST_RESULT_QUEUE_URL=https://sqs.us-west-1.amazonaws.com/account/certscore-v2-dag-usw-results

GMAIL_SMTP_USER=admin@certscore.ai
GMAIL_SMTP_APP_PASSWORD=your-google-workspace-app-password
FEEDBACK_TO_EMAIL=team@example.com
CONTACT_SALES_TO_EMAIL=sales@certscore.ai
OPS_ALERT_TO_EMAIL=ops@example.com
BILLING_ALERT_TO_EMAIL=billing@example.com
OPENAI_API_KEY=
CERTSCORE_EXTRACTION_MODEL=gpt-5.4-nano
CERTSCORE_REVIEW_MODEL=gpt-5.4-mini
CERTSCORE_ESCALATION_MODEL=
CERTSCORE_MINI_REVIEW_ENABLED=0
CERTSCORE_MINI_EXCEPTION_ROUTING_ENABLED=0
CERTSCORE_NANO_PRIMARY_POLICY_REVIEW_ENABLED=0
CERTSCORE_ESCALATION_ENABLED=0
CERTSCORE_MODEL_REVIEW_MODE=shadow
