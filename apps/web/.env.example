NODE_ENV=development

# Local web app URL. Keep this pointed at localhost for dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_FLAVOR=certscore

# Use a dedicated Supabase dev project for local auth and data.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-supabase-service-role-key

# Optional auth toggle for the login screen.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
NEXT_PUBLIC_ULTRA_CHECKOUT_URL=

# Shared platform integrations used by the web app.
REDIS_URL=redis://127.0.0.1:6379
VALIDATION_REDIS_URL=redis://127.0.0.1:6380
SUPABASE_STORAGE_BUCKET=scan-reports
SUPABASE_STORAGE_BUCKET_SCREENSHOTS=scan-screenshots
SUPABASE_STORAGE_BUCKET_ARTIFACTS=scan-artifacts

# Optional app features.
GMAIL_SMTP_USER=you@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-gmail-app-password
FEEDBACK_TO_EMAIL=team@example.com
OPENAI_API_KEY=
