{
  "name": "@website-signal-risk-scanner/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @website-signal-risk-scanner/shared build && pnpm check-runtime:build && next build",
    "build:tranco-calibration": "node --enable-source-maps --import tsx ./scripts/build-tranco-calibration-queue.ts",
    "check-env:amplify-runtime": "node --enable-source-maps --import tsx ./scripts/check-amplify-runtime-env.ts",
    "check-env": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/check-env.ts",
    "check-env:validation-cutover": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/check-validation-cutover-env.ts",
    "check-runtime": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/check-runtime.ts",
    "check-runtime:build": "node --enable-source-maps --import tsx ./scripts/check-runtime.ts --allow-missing-env",
  "indexnow:submit": "node --enable-source-maps --import tsx ./scripts/submit-indexnow.ts",
  "import:wc01-v2-evidence-preview": "node --env-file-if-exists=.env.local --enable-source-maps --import tsx ./scripts/import-wc01-v2-evidence-preview.ts",
  "smoke:wc01-v2-reviewer-decisions": "node --env-file-if-exists=.env.local --enable-source-maps --import tsx ./scripts/smoke-wc01-v2-reviewer-decisions.ts",
  "monitoring:sweep": "node --env-file-if-exists=.env.local --enable-source-maps --import tsx ./scripts/run-scheduled-monitoring.ts",
    "scanner-quality:aggregate": "node --env-file-if-exists=.env.local --enable-source-maps --import tsx ./scripts/aggregate-scanner-quality-history.ts",
    "check:production-finding-calibration": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/check-production-finding-calibration.ts",
    "audit:production-finding-demotions": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/audit-production-finding-demotions.ts",
    "audit:production-finding-evidence": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/audit-production-finding-demotions.ts",
    "audit:production-evidence-loss": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/audit-production-evidence-loss.ts",
    "audit:production-evidence-lineage": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/audit-production-evidence-lineage.ts",
    "audit:cookie-disclosure-gap-reconciliation": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/reconcile-cookie-disclosure-gap.ts",
    "audit:positive-disclosure-reconciliation": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/reconcile-positive-disclosure-findings.ts",
    "audit:preconsent-reconciliation": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/reconcile-preconsent-tracking.ts",
    "audit:cookie-evidence-debug": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/audit-cookie-evidence-debug.ts",
    "audit:fingerprinting-evidence-coverage": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/audit-fingerprinting-evidence-coverage.ts",
    "california:replay": "node --enable-source-maps --import tsx ./scripts/california-phase2-replay.ts",
    "california:queue-cohort-reruns": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/queue-california-cohort-reruns.ts",
    "gdpr-eprivacy:queue-cohort-reruns": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/queue-gdpr-eprivacy-cohort-reruns.ts",
    "review:cookie-disclosure-gap-urls": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/review-cookie-disclosure-gap-urls.ts",
    "audit:urlscan-supplements": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/audit-urlscan-supplements.ts",
    "review:production-finding-surfacing": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/review-production-finding-surfacing.ts",
    "review:production-policy-nano": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/review-production-policy-nano-candidates.ts",
    "validate:noisy-findings:postdeploy": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/run-noisy-finding-postdeploy-validation.ts",
    "test:production-finding-calibration": "pnpm check:production-finding-calibration -- --fail-on-review",
    "run:tranco-batch": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/run-tranco-calibration-batch.ts",
    "compare:tranco-batch": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/compare-prod-local-tranco-calibration.ts",
    "run:tranco-session": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/run-tranco-calibration-session.ts",
    "run:tranco-session:2h": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/run-tranco-calibration-session.ts --hours 2 --poll-minutes 1 --batch-limit 20 --max-pending-batches 3 --out-dir ./tmp/tranco-calibration/session-2h",
    "refresh:tranco-scorecard": "node --enable-source-maps --import tsx ./scripts/refresh-tranco-accuracy-scorecard.ts",
    "report:production-findings": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/report-production-finding-frequency.ts",
    "status:tranco-session": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/tranco-calibration-status.ts",
    "watch:tranco-status": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/watch-tranco-status.ts",
    "validate:tranco-review-export": "node --enable-source-maps --import tsx ./scripts/validate-tranco-review-export.ts",
    "eval:build-finding-corpus": "node --env-file=.env.local --enable-source-maps --import tsx ./scripts/eval/build-finding-corpus.ts",
    "eval:inspect-coverage-edge-corpus": "node ./scripts/eval/inspect-coverage-edge-corpus.mjs",
    "dev": "NODE_OPTIONS=${NODE_OPTIONS:---max-old-space-size=2048} next dev --turbo --port 3000",
    "dev:validation:local": "NODE_OPTIONS=${NODE_OPTIONS:---max-old-space-size=2048} next dev --turbo --port 3003",
    "typecheck": "next typegen . && tsc --noEmit",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@certscore/contracts": "workspace:*",
    "@certscore/report-adapter": "workspace:*",
    "@certscore/review-engine": "workspace:*",
    "@aws-sdk/client-s3": "^3.1031.0",
    "@aws-sdk/s3-request-presigner": "^3.1031.0",
    "@website-signal-risk-scanner/db": "workspace:*",
    "@website-signal-risk-scanner/shared": "workspace:*",
    "@website-signal-risk-scanner/ui": "workspace:*",
    "@website-signal-risk-scanner/validation-shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.5",
    "next": "^15.2.0",
    "nodemailer": "^6.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  }
}
