{
  "name": "@website-signal-risk-scanner/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-env": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/check-env.ts",
    "check-runtime": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/check-runtime.ts",
    "dev": "bash ./scripts/run-dev-watch.sh ./src/index.ts",
    "dev:validation": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./src/validation/index.ts",
    "dev:validation:watch": "bash ./scripts/run-dev-watch.sh ./src/validation/index.ts",
    "dev:validation:local": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./src/validation/index.ts",
    "benchmark:accessibility": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/accessibility-benchmark-matrix.ts",
    "benchmark:accessibility:assert": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/accessibility-benchmark-matrix.ts --run-now --assert",
    "start": "node --enable-source-maps ./dist/apps/worker/src/index.js",
    "start:validation": "node --enable-source-maps ./dist/apps/worker/src/validation/index.js",
    "start:scheduler": "node --enable-source-maps ./dist/apps/worker/src/scheduling/run-scheduler.js",
    "start:validation:scheduler": "node --enable-source-maps ./dist/apps/worker/src/validation/run-scheduler.js",
    "playwright:install": "playwright install chromium",
    "smoke:scheduler": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./src/scheduling/run-scheduler.ts",
    "scheduler:sweep": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./src/scheduling/run-scheduler.ts",
    "reconcile:queues": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./scripts/reconcile-stale-queue-state.ts",
    "validation:scheduler": "node --env-file=../web/.env.local --enable-source-maps --import tsx ./src/validation/run-scheduler.ts --once",
    "test": "node --import tsx --test ./src/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@website-signal-risk-scanner/db": "workspace:*",
    "@website-signal-risk-scanner/scan-core": "workspace:*",
    "@website-signal-risk-scanner/shared": "workspace:*",
    "axe-core": "^4.10.3",
    "bullmq": "^5.43.0",
    "ioredis": "^5.4.2",
    "playwright": "^1.51.1",
    "puppeteer-core": "^24.7.1",
    "zod": "^3.24.2"
  }
}
