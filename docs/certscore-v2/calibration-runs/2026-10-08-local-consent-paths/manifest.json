      "boundedSanitizedArtifactsRequired": true
    },
    "ownedCanaries": {
      "requiredForScannerRelease": true,
      "initiatesPublicTraffic": true,
      "ownershipRequired": true
    },
    "rotatingPublicSample": {
      "requiredForScannerRelease": true,
      "initiatesPublicTraffic": true,
      "requiresEligibilityAttestation": true,
      "minimumSize": 8,
      "defaultSize": 10,
      "maximumSize": 12
    },
    "passiveProductionSampling": {
      "requiredForPostDeployReview": true,
      "initiatesAdditionalTraffic": false,
      "defaultSampleSize": 10
    }
  },
  "publicContactPolicy": {
    "minimumCooldownDays": 28,
    "maximumConcurrentScansPerDomain": 1,
    "automaticRetryAfterNoGo": false,
    "crossRegionRetryAfterBlock": false,
    "retireAfterRepeatedNoGo": true,
    "eligibilityStates": [
      "eligible",
      "cooldown",
      "blocked",
      "do_not_calibrate"
    ]
  },
  "owners": {
    "calibrationQuality": "Luna",
    "productionOperations": "SO",
    "implementation": "WC01"
  },
  "laneDefinitions": {
    "consent_controls": "Retain and classify first-layer consent controls, including late and localized controls.",
    "gdpr_transparency": "Discover policy surfaces, retain usable text, and project canonical transparency topics.",
    "transport_evidence": "Retain typed transport observations and distinguish unknown from negative evidence.",
    "third_party_attribution": "Classify first-party and third-party requests, cookies, vendors, and final-document redirects.",
    "no_go_resilience": "Propagate blocked, captcha, timeout, unsupported, and incomplete outcomes with reasons.",
    "language_inference": "Produce a best-effort primary language from retained evidence with an honest unknown fallback."
  },
  "requiredLanes": [
    "consent_controls",
    "gdpr_transparency",
    "transport_evidence",
    "third_party_attribution",
    "no_go_resilience",
    "language_inference"
