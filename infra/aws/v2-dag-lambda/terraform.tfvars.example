image_uris = {
  eu_central_1 = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/certscore-v2-dag-local-lambda@sha256:REPLACE"
  eu_west_1    = "123456789012.dkr.ecr.eu-west-1.amazonaws.com/certscore-v2-dag-local-lambda@sha256:REPLACE"
  us_west_1    = "123456789012.dkr.ecr.us-west-1.amazonaws.com/certscore-v2-dag-local-lambda@sha256:REPLACE"
}

alarm_actions_by_region = {
  eu-central-1 = ["arn:aws:sns:eu-central-1:123456789012:certscore-operations"]
  eu-west-1    = ["arn:aws:sns:eu-west-1:123456789012:certscore-operations"]
  us-west-1    = ["arn:aws:sns:us-west-1:123456789012:certscore-operations"]
}

# The US-CA scanner must fail closed unless the proxy public IP geolocates to
# California in the retained EgressPreflight artifact. The current live proxy
# observed Oregon in the old us-west-2 lane and therefore did not satisfy this guard.
expected_egress_region_by_region = {
  us-west-1 = "California"
}

# Preserve the existing regional proxy variables during import. Never commit
# credentials; place real values in an ignored .auto.tfvars file or a secrets-aware runner.
environment_variables_by_region = {
  eu-central-1 = {
    SCAN_PROXY_ENABLED = "true"
    SCAN_EGRESS_LABEL  = "eu-de-production"
  }
}

# The production default resolves this us-west-1 secret into Lambda's encrypted
# regional environments and encrypted Terraform state. Override only for a
# coordinated ConsentCheck Web Bot Auth key rotation.
web_bot_auth_private_key_secret_id = "consentcheck/web-bot-auth-private-key-pem"

# Populate only for regions whose existing Lambda is VPC-attached.
vpc_config_by_region = {
  eu-central-1 = {
    subnet_ids         = ["subnet-replace"]
    security_group_ids = ["sg-replace"]
  }
}

# Existing VPC topology for private S3, SQS, and Lambda service endpoints.
# Replace placeholders from the read-only regional inventory before planning.
# This creates endpoint resources only; NAT routes, NAT gateways, proxies,
# Lambda functions, buckets, queues, and scanner IAM roles remain untouched.
vpc_endpoint_config_by_region = {
  eu-central-1 = {
    vpc_id                   = "vpc-replace"
    route_table_ids          = ["rtb-replace"]
    subnet_ids               = ["subnet-replace"]
    lambda_security_group_id = "sg-replace"
    # Standard Lambda stdout/stderr logging is delivered by the Lambda
    # service. Enable this only if function code starts calling the Logs API.
    enable_logs_endpoint     = false
  }
  eu-west-1 = {
    vpc_id                   = "vpc-replace"
    route_table_ids          = ["rtb-replace"]
    subnet_ids               = ["subnet-replace"]
    lambda_security_group_id = "sg-replace"
    enable_logs_endpoint     = false
  }
  us-west-1 = {
    vpc_id                   = "vpc-replace"
    route_table_ids          = ["rtb-replace"]
    subnet_ids               = ["subnet-replace"]
    lambda_security_group_id = "sg-replace"
    # Preserve the imported live endpoint until its separately canaried
    # retirement. New regional migrations should normally set this false.
    enable_logs_endpoint     = false
  }
}
