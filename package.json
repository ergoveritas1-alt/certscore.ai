{
  "name": "website-signal-risk-scanner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check-env": "pnpm --filter @website-signal-risk-scanner/web check-env",
    "check-env:validation": "pnpm --filter @website-signal-risk-scanner/validation-web check-env && pnpm --filter @website-signal-risk-scanner/validation-worker check-env",
    "check-runtime": "pnpm --filter @website-signal-risk-scanner/web check-runtime",
    "check-runtime:validation": "pnpm --filter @website-signal-risk-scanner/validation-web check-runtime && pnpm --filter @website-signal-risk-scanner/validation-worker check-runtime",
    "dev": "turbo run dev --parallel",
    "dev:control-plane": "bash ./scripts/run-validation-dev.sh",
    "dev:all": "bash ./scripts/run-all-dev.sh",
    "dev:certscore:web": "pnpm --filter @website-signal-risk-scanner/web dev",
    "dev:validation": "bash ./scripts/run-validation-dev.sh",
    "dev:validation:local": "pnpm --parallel --stream --filter @website-signal-risk-scanner/web --filter @website-signal-risk-scanner/validation-worker run dev",
    "dev:validation:web": "pnpm --filter @website-signal-risk-scanner/validation-web dev",
    "dev:validation:worker": "pnpm --filter @website-signal-risk-scanner/validation-worker dev",
    "dev:validation:scheduler": "pnpm --filter @website-signal-risk-scanner/validation-worker scheduler",
    "gcloud:auth": "bash ./scripts/gcloud-auth-login.sh",
    "ops:monitor:prod": "pnpm exec tsx ./scripts/monitor-prod-ops.ts",
    "restart:certscore": "bash ./scripts/restart-certscore.sh",
    "restart:validation:web": "bash ./scripts/restart-validation-web.sh",
    "restart:localhost": "bash ./scripts/restart-localhost.sh",
    "supabase:login": "npx supabase@latest login",
    "supabase:link": "npx supabase@latest link --project-ref ibjxttgmvdkbuqllbazj",
    "supabase:link:prod": "npx supabase@latest link --project-ref wgfhzyrysztmtrjbcsgy",
    "supabase:reload-schema:dev": "pnpm exec tsx ./scripts/reload-supabase-schema-cache.ts --project-ref ibjxttgmvdkbuqllbazj",
    "supabase:reload-schema:prod": "pnpm exec tsx ./scripts/reload-supabase-schema-cache.ts --project-ref wgfhzyrysztmtrjbcsgy",
    "supabase:audit:prod": "pnpm exec tsx ./scripts/audit-prod-schema.ts",
    "supabase:push": "npx supabase@latest db push",
    "supabase:status": "npx supabase@latest status",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
