{
  "name": "website-signal-risk-scanner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check-env": "pnpm --filter @website-signal-risk-scanner/web check-env",
    "check-env:validation": "pnpm --filter @website-signal-risk-scanner/validation-worker check-env",
    "check-env:validation-cutover": "pnpm --filter @website-signal-risk-scanner/web check-env:validation-cutover",
    "check-runtime": "pnpm --filter @website-signal-risk-scanner/web check-runtime",
    "check-runtime:validation": "pnpm --filter @website-signal-risk-scanner/validation-worker check-runtime",
    "dev": "turbo run dev --parallel",
    "dev:control-plane": "bash ./scripts/run-validation-dev.sh",
    "dev:all": "bash ./scripts/run-all-dev.sh",
    "dev:certscore:web": "pnpm --filter @website-signal-risk-scanner/web dev",
    "dev:storage:local": "bash ./scripts/run-local-minio.sh",
    "dev:scanner:local": "bash ./scripts/run-ws01-scanner-dev.sh",
    "dev:validation": "bash ./scripts/run-validation-dev.sh",
    "dev:validation:local": "pnpm --parallel --stream --filter @website-signal-risk-scanner/web --filter @website-signal-risk-scanner/validation-worker run dev",
    "dev:validation:worker": "pnpm --filter @website-signal-risk-scanner/validation-worker dev",
    "dev:validation:scheduler": "pnpm --filter @website-signal-risk-scanner/validation-worker scheduler",
    "ops:check:deploy": "bash ./scripts/check-deployment-pathways.sh",
    "ops:check:scanner-deploy": "bash ./scripts/check-scanner-deploy-health.sh",
    "ops:check:live": "pnpm exec tsx ./scripts/check-live-deployment-state.ts",
    "ops:check:live-db": "pnpm exec tsx ./scripts/check-live-db-consistency.ts",
    "ops:smoke:auth": "pnpm exec tsx ./scripts/check-production-auth-smoke.ts",
    "ops:smoke:ada-financial": "pnpm exec tsx ./scripts/check-ada-financial-live-smoke.ts",
    "ops:smoke:findings": "pnpm exec tsx ./scripts/check-live-finding-smoke.ts",
    "audit:production-evidence-lineage": "pnpm --filter @website-signal-risk-scanner/web audit:production-evidence-lineage",
    "check:production-finding-calibration": "pnpm --filter @website-signal-risk-scanner/web test:production-finding-calibration",
    "ops:verify:ada-live": "pnpm exec tsx ./scripts/run-ada-live-verification.ts",
    "db:migrate": "pnpm exec tsx ./scripts/apply-db-migrations.ts",
    "db:import-json": "pnpm exec tsx ./scripts/import-json-to-postgres.ts",
    "ops:monitor:prod": "pnpm exec tsx ./scripts/monitor-prod-ops.ts",
    "smoke:validation:financial": "pnpm --filter @website-signal-risk-scanner/validation-worker smoke:validation:financial",
    "test:web-bot-auth": "pnpm --filter @website-signal-risk-scanner/web-bot-auth build && npx -y node@22 --import tsx --test packages/web-bot-auth/src/index.test.ts",
    "web-bot-auth:generate": "npx -y node@22 --import tsx ./scripts/generate-web-bot-auth-key.ts",
    "web-bot-auth:print": "npx -y node@22 --import tsx ./scripts/print-web-bot-auth-status.ts",
    "web-bot-auth:test-request": "npx -y node@22 --import tsx ./scripts/test-web-bot-auth-request.ts",
    "restart:certscore": "bash ./scripts/restart-certscore.sh",
    "restart:localhost": "bash ./scripts/restart-localhost.sh",
    "test:scan-pipeline": "pnpm --filter @website-signal-risk-scanner/validation-worker test:scan-pipeline",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
