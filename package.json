{
  "name": "website-signal-risk-scanner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check-env": "pnpm --filter @website-signal-risk-scanner/web check-env",
    "check-env:validation": "pnpm --filter @website-signal-risk-scanner/validation-worker check-env",
    "check-env:validation-cutover": "pnpm --filter @website-signal-risk-scanner/web check-env:validation-cutover",
    "check-runtime": "pnpm --filter @website-signal-risk-scanner/web check-runtime",
    "check-runtime:validation": "pnpm --filter @website-signal-risk-scanner/validation-worker check-runtime",
    "codex:health": "bash ./scripts/check-codex-local-health.sh",
    "codex:health:watch": "bash ./scripts/check-codex-local-health.sh --watch",
    "local:scan:ready": "bash ./scripts/ensure-local-scan-stack.sh",
    "dev": "turbo run dev --parallel",
    "dev:control-plane": "bash ./scripts/run-validation-dev.sh",
    "dev:all": "bash ./scripts/run-all-dev.sh",
    "dev:certscore:web": "pnpm --filter @website-signal-risk-scanner/web dev",
    "dev:mcp": "pnpm --filter @certscore/mcp-http dev",
    "dev:storage:local": "bash ./scripts/run-local-minio.sh",
    "dev:scanner:local": "bash ./scripts/run-ws01-scanner-dev.sh",
    "dev:validation": "bash ./scripts/run-validation-dev.sh",
    "dev:validation:local": "pnpm --parallel --stream --filter @website-signal-risk-scanner/web --filter @website-signal-risk-scanner/validation-worker run dev",
    "dev:validation:worker": "pnpm --filter @website-signal-risk-scanner/validation-worker dev",
    "dev:validation:scheduler": "pnpm --filter @website-signal-risk-scanner/validation-worker scheduler",
    "ops:check:deploy": "bash ./scripts/check-deployment-pathways.sh",
    "ops:check:ecs-service-deploy": "bash ./scripts/check-ecs-service-deploy-health.sh",
    "ops:check:mcp-http-deploy": "node --import tsx ./scripts/check-mcp-http-deploy-readiness.ts",
    "ops:check:mcp-source": "node --import tsx ./scripts/verify-mcp-source-tracked.ts",
    "ops:check:no-scanner-ecs": "bash ./scripts/assert-no-scanner-ecs.sh",
    "ops:check:scanner-region-parity": "node --import tsx ./scripts/check-regional-scanner-parity.ts",
    "deploy:all": "node --import tsx ./scripts/deploy-fast.ts all",
    "deploy:db": "node --import tsx ./scripts/deploy-fast.ts db",
    "deploy:scanners": "node --import tsx ./scripts/deploy-fast.ts scanners",
    "deploy:validation": "node --import tsx ./scripts/deploy-fast.ts validation",
    "deploy:web": "node --import tsx ./scripts/deploy-fast.ts web",
    "preflight:all": "node --import tsx ./scripts/predeploy.ts --fast --all",
    "preflight:fast": "node --import tsx ./scripts/predeploy.ts --fast",
    "preflight:full": "node --import tsx ./scripts/predeploy.ts --full",
    "ops:dns:add-openai-verification": "node ./scripts/ops/add-openai-domain-verification-txt.mjs",
    "ops:repair:stale-scans": "node --env-file=apps/web/.env.local --enable-source-maps --import tsx ./scripts/repair-stale-running-scans.ts",
    "ops:check:live": "pnpm exec tsx ./scripts/check-live-deployment-state.ts",
    "ops:check:live-db": "pnpm exec tsx ./scripts/check-live-db-consistency.ts",
    "ops:smoke:auth": "pnpm exec tsx ./scripts/check-production-auth-smoke.ts",
    "ops:smoke:ada-financial": "pnpm exec tsx ./scripts/check-ada-financial-live-smoke.ts",
    "ops:smoke:bx01-handoff": "pnpm exec tsx ./scripts/smoke-bx01-handoff.ts",
    "ops:smoke:findings": "pnpm exec tsx ./scripts/check-live-finding-smoke.ts",
    "ops:smoke:pulse": "BASE_URL=https://certscore.ai node --import tsx ./scripts/smoke-pulse-endpoints.ts",
    "ops:smoke:pulse-production": "BASE_URL=https://certscore.ai node ./scripts/smoke-pulse-production.mjs",
    "ops:smoke:mcp-production": "node --import tsx ./scripts/smoke-certscore-mcp-production.ts",
    "mcp:certscore": "corepack pnpm --filter @certscore/api-contracts build && corepack pnpm --filter @certscore/sdk build && corepack pnpm --filter @certscore/mcp build && node packages/certscore-mcp/dist/certscore-mcp.mjs",
    "mcp:certscore:http": "corepack pnpm --filter @certscore/api-contracts build && corepack pnpm --filter @certscore/sdk build && corepack pnpm --filter @certscore/mcp-auth build && corepack pnpm --filter @certscore/mcp build && corepack pnpm --filter @certscore/mcp-http build && node apps/mcp/dist/index.js",
    "mcp:certscore:http:tools-diff": "corepack pnpm --filter @certscore/api-contracts build && corepack pnpm --filter @certscore/sdk build && corepack pnpm --filter @certscore/mcp-auth build && corepack pnpm --filter @certscore/mcp build && node --import tsx ./scripts/smoke-certscore-mcp-http-tools-diff.ts",
    "mcp:certscore:smoke": "corepack pnpm --filter @certscore/api-contracts build && corepack pnpm --filter @certscore/sdk build && corepack pnpm --filter @certscore/mcp build && node scripts/smoke-certscore-mcp.mjs",
    "mcp:certscore:homebrew:build": "node --import tsx ./scripts/build-certscore-mcp-homebrew-release.ts",
    "mcp:certscore:generate-key": "node --env-file=apps/web/.env.local --enable-source-maps --import tsx ./scripts/generate-certscore-api-key.ts",
    "ops:stripe:setup-billing": "node --env-file=apps/web/.env.local --enable-source-maps --import tsx ./scripts/setup-stripe-billing.ts",
    "ops:preconsent:diagnose": "node --env-file=apps/web/.env.local --enable-source-maps --import tsx ./scripts/preconsent-cookie-evidence-ops.ts diagnose",
    "ops:preconsent:backfill-cookies": "node --env-file=apps/web/.env.local --enable-source-maps --import tsx ./scripts/preconsent-cookie-evidence-ops.ts backfill",
    "ops:preconsent:queue-reruns": "node --env-file=apps/web/.env.local --enable-source-maps --import tsx ./scripts/preconsent-cookie-evidence-ops.ts queue-reruns",
    "ops:gdpr-eprivacy:queue-cohort-reruns": "pnpm --filter @website-signal-risk-scanner/web gdpr-eprivacy:queue-cohort-reruns",
    "audit:production-evidence-loss": "pnpm --filter @website-signal-risk-scanner/web audit:production-evidence-loss",
    "audit:production-evidence-lineage": "pnpm --filter @website-signal-risk-scanner/web audit:production-evidence-lineage",
    "check:production-finding-calibration": "pnpm --filter @website-signal-risk-scanner/web test:production-finding-calibration",
    "ops:verify:ada-live": "pnpm exec tsx ./scripts/run-ada-live-verification.ts",
    "db:migrate": "pnpm exec tsx ./scripts/apply-db-migrations.ts",
    "db:import-json": "pnpm exec tsx ./scripts/import-json-to-postgres.ts",
    "ops:monitor:prod": "pnpm exec tsx ./scripts/monitor-prod-ops.ts",
    "ops:monitor:prod:aws": "pnpm exec tsx ./scripts/run-prod-ops-monitor-ecs.ts",
    "ops:monitoring:sweep": "pnpm --filter @website-signal-risk-scanner/web monitoring:sweep",
    "ops:prod-db:audit": "pnpm exec tsx ./scripts/run-prod-db-audit-ecs.ts",
    "ops:prod-preconsent-rerun": "pnpm exec tsx ./scripts/run-prod-preconsent-rerun-ecs.ts",
    "ops:scan-acceleration:audit": "node --env-file=apps/web/.env.local --enable-source-maps --import tsx ./scripts/audit-prior-scan-acceleration.ts",
    "ops:scan-acceleration:benchmark": "pnpm exec tsx ./scripts/run-prior-scan-benchmark.ts",
    "ops:scan-timing:sample": "pnpm exec tsx ./scripts/run-scan-timing-sample.ts",
    "ops:prod-db:nano-backfill": "pnpm exec tsx ./scripts/run-prod-nano-signal-backfill-ecs.ts",
    "smoke:validation:financial": "pnpm --filter @website-signal-risk-scanner/validation-worker smoke:validation:financial",
    "test:web-bot-auth": "pnpm --filter @website-signal-risk-scanner/web-bot-auth build && npx -y node@22 --import tsx --test packages/web-bot-auth/src/index.test.ts",
    "web-bot-auth:generate": "npx -y node@22 --import tsx ./scripts/generate-web-bot-auth-key.ts",
    "web-bot-auth:print": "npx -y node@22 --import tsx ./scripts/print-web-bot-auth-status.ts",
    "web-bot-auth:test-request": "npx -y node@22 --import tsx ./scripts/test-web-bot-auth-request.ts",
    "restart:certscore": "bash ./scripts/restart-certscore.sh",
    "restart:localhost": "bash ./scripts/restart-localhost.sh",
    "test:scan-pipeline": "pnpm --filter @website-signal-risk-scanner/validation-worker test:scan-pipeline",
    "test:canonical-projection-parity": "pnpm --filter @certscore/api-contracts build && pnpm exec tsx --test apps/web/lib/scans/canonical-surface-summary.test.ts apps/web/server/scans/canonical-consent-control-flow.test.ts apps/web/lib/scans/runtime-cookie-evidence.test.ts apps/web/lib/scans/runtime-inventory-projection.test.ts apps/web/lib/scans/gdpr-eprivacy-coverage-policy.test.ts apps/web/lib/pulse/projection.test.ts apps/web/lib/api-v2/scan-resource.test.ts packages/certscore-api-contracts/src/pulse-v1.test.ts packages/certscore-mcp/src/server.test.ts packages/certscore-scan-core/src/consent-control-geometry.test.ts",
    "v2:scan": "pnpm --filter @certscore/scan-core build && PLAYWRIGHT_BROWSERS_PATH= node --env-file=apps/web/.env.local --import tsx ./packages/certscore-scan-core/src/cli/scan.ts",
    "v2:consent-dag-shadow": "pnpm --filter @certscore/scan-core build && PLAYWRIGHT_BROWSERS_PATH= TSX_TSCONFIG_PATH=tsconfig.base.json node --env-file=apps/web/.env.local --import tsx ./packages/certscore-scan-core/src/cli/consent-dag-shadow.ts",
    "v2:demo": "pnpm --filter @certscore/scan-core build && PLAYWRIGHT_BROWSERS_PATH= node --env-file=apps/web/.env.local --import tsx ./packages/certscore-scan-core/src/cli/demo.ts",
    "v2:inspect": "pnpm -s --filter @certscore/contracts build && node --import tsx ./packages/certscore-scan-core/src/cli/inspect.ts",
    "v2:review": "pnpm --filter @certscore/review-engine build && node --import tsx ./packages/certscore-review-engine/src/cli/review.ts",
    "v2:replay": "PLAYWRIGHT_BROWSERS_PATH= node --import tsx ./packages/certscore-scan-core/src/cli/replay.ts",
    "v2:wc01-artifact-chain-smoke": "node --import tsx ./scripts/run-wc01-v2-artifact-chain-smoke.ts",
    "v2:wc01-scan-lab-cohort": "node --env-file=apps/web/.env.local --import tsx ./scripts/run-wc01-v2-scan-lab-cohort.ts",
    "v2:wc01-verify-scan-lab-cohort": "node --import tsx ./scripts/verify-wc01-v2-scan-lab-cohort.ts",
    "v2:calibration-registry-check": "node --import tsx ./scripts/verify-scan-quality-calibration-registry.ts",
    "v2:calibration-target-select": "node --import tsx ./scripts/select-scan-quality-calibration-targets.ts",
    "v2:calibration-ledger-record": "node --import tsx ./scripts/record-scan-quality-calibration-outcomes.ts",
    "v2:calibration-ledger-export": "node --import tsx ./scripts/export-scan-quality-calibration-ledger.ts",
    "v2:consent-canary-gate": "node --import tsx ./scripts/run-consent-controls-canary-gate.ts",
    "v2:consent-fast-release-gate": "node --import tsx ./scripts/run-consent-capture-fast-release-gate.ts",
    "v2:retained-consent-audit": "node --import tsx ./scripts/audit-retained-consent-cohort.ts",
    "v2:consent-assessment-replay": "node --import tsx ./scripts/replay-consent-control-assessment.ts",
    "v2:consent-assessment-adjudication": "node --import tsx ./scripts/build-consent-assessment-adjudication-packet.ts",
    "v2:consent-assessment-adjudication-triage": "node --import tsx ./scripts/build-consent-assessment-adjudication-triage.ts",
    "v2:consent-assessment-review-worksheet": "node --import tsx ./scripts/export-consent-assessment-review-worksheet.ts",
    "v2:consent-assessment-review-validate": "node --import tsx ./scripts/validate-consent-assessment-review-worksheet.ts",
    "v2:consent-assessment-human-calibrate": "node --import tsx ./scripts/calibrate-consent-control-review.ts",
    "v2:consent-geometry-human-verify": "node --import tsx ./scripts/verify-consent-geometry-human-review.ts",
    "v2:consent-assessment-backfill-plan": "node --import tsx ./scripts/plan-consent-assessment-backfill.ts",
    "v2:consent-assessment-backfill-verify": "node --import tsx ./scripts/verify-consent-assessment-backfill-plan.ts",
    "v2:verify-prod-consent-artifacts": "node --env-file=apps/web/.env.local --import tsx ./scripts/verify-prod-consent-control-artifacts.ts",
    "v2:evidence-calibration-manifest": "node --import tsx ./scripts/build-evidence-calibration-manifest.ts",
    "v2:gdpr-transparency-retained-audit": "node --import tsx ./scripts/audit-gdpr-transparency-retained-corpus.ts",
    "v2:gdpr-transparency-post-projection-sample": "node --import tsx ./scripts/build-gdpr-transparency-post-projection-sample.ts",
    "v2:gdpr-transparency-prod-region-provenance": "node --import tsx ./scripts/audit-prod-region-provenance.ts",
    "v2:gdpr-transparency-fetch-regional-sample": "node --import tsx ./scripts/fetch-regional-gdpr-passive-sample.ts",
    "v2:gdpr-transparency-live-calibration": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx ./scripts/audit-gdpr-transparency-multilingual-live-calibration.ts",
    "v2:privacy-policy-gap-analysis": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx ./scripts/analyze-privacy-policy-gap-cohort.ts",
    "v2:privacy-policy-capture-gate": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx ./scripts/verify-privacy-policy-capture-calibration.ts",
    "v2:calibration-contact-persist": "node --import tsx ./scripts/persist-scan-quality-calibration-contacts.ts",
    "v2:wc01-capture-cohort-fixtures": "node --import tsx ./scripts/capture-wc01-v2-cohort-fixture-candidates.ts",
    "v2:qualify-privacy-control-seeds": "PLAYWRIGHT_BROWSERS_PATH= node --import tsx ./scripts/qualify-v2-privacy-control-seeds.ts",
    "v2:gold-corpus-expansion-waves": "node --import tsx ./scripts/build-v2-gold-corpus-expansion-waves.ts",
    "v2:gold-expansion-quality": "node --import tsx ./scripts/analyze-v2-gold-expansion-quality.ts",
    "v2:gold-corpus-current-manifest": "node --import tsx ./scripts/build-v2-current-gold-corpus-manifest.ts",
    "v2:gold-corpus-quality-gate": "node --import tsx ./scripts/verify-v2-current-gold-corpus-quality.ts",
    "v2:gold-corpus-repair-pass": "node --env-file=apps/web/.env.local --import tsx ./scripts/run-v2-gold-corpus-repair-pass.ts",
    "v2:consent-dag-readiness-gate": "node --import tsx ./scripts/verify-v2-consent-dag-readiness-gate.ts",
    "v2:consent-dag-rollout-packet": "node --import tsx ./scripts/build-v2-consent-dag-rollout-evidence-packet.ts",
    "v2:consent-dag-rollout-proposal": "node --import tsx ./scripts/build-v2-consent-dag-rollout-proposal.ts",
    "v2:consent-control-inventory-cohort": "PLAYWRIGHT_BROWSERS_PATH= TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx ./scripts/run-consent-control-inventory-cohort.ts",
    "v2:consent-geometry-aro-nogo-gate": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx ./scripts/run-consent-geometry-aro-nogo-lambda-gate.ts",
    "v2:consent-geometry-aro-nogo-adversarial": "pnpm v2:consent-geometry-aro-nogo-gate --cohort adversarial --min-loaded-exact-agreement 0 --min-field-agreement 0 --require-no-go-sites 0 --max-uncertain-fields 200 --allow-missing-proof",
    "v2:local-dag-lambda-smoke": "node --env-file=apps/web/.env.local --import tsx ./scripts/smoke-local-v2-dag-lambda.ts",
    "v2:local-dag-lambda-benchmark": "node --env-file=apps/web/.env.local --import tsx ./scripts/run-local-v2-dag-lambda-benchmark.ts",
    "v2:lambda-memory-canary-compare": "node --import tsx ./scripts/compare-v2-lambda-memory-canary.ts",
    "v2:local-dag-lambda-parity-cohort": "TSX_TSCONFIG_PATH=tsconfig.base.json node --env-file=apps/web/.env.local --import tsx ./scripts/run-local-v2-dag-lambda-parity-cohort.ts",
    "v2:local-dag-lambda-parity": "PLAYWRIGHT_BROWSERS_PATH= TSX_TSCONFIG_PATH=tsconfig.base.json node --env-file=apps/web/.env.local --import tsx ./scripts/run-local-v2-dag-lambda-parity.ts",
    "v2:local-dag-lambda-quality": "node --import tsx ./scripts/compare-local-v2-dag-lambda-quality.ts",
    "v2:multilingual-local-checklist-compare": "TSX_TSCONFIG_PATH=tsconfig.base.json node --env-file=apps/web/.env.local --import tsx ./scripts/compare-multilingual-privacy-evidence-checklist-local.ts",
    "v2:multilingual-local-evidence-quality": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx ./scripts/audit-multilingual-gdpr-evidence-quality-local.ts",
    "v2:multilingual-local-cohort": "PLAYWRIGHT_BROWSERS_PATH= TSX_TSCONFIG_PATH=tsconfig.base.json node --env-file=apps/web/.env.local --import tsx ./scripts/run-multilingual-privacy-evidence-local-cohort.ts",
    "v2:multilingual-gold": "pnpm --filter @certscore/scan-core exec tsx --tsconfig ../../tsconfig.base.json --test src/multilingual-privacy-evidence-gold.test.ts",
    "v2:multilingual-live-calibration": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx ./scripts/audit-multilingual-privacy-evidence-live-calibration.ts",
    "v2:replay-gold-coverage": "node --import tsx ./scripts/verify-v2-replay-gold-corpus.ts",
    "v2:replay-gold-quality": "node --import tsx ./scripts/verify-v2-replay-gold-corpus.ts",
    "v2:regulatory-gold-corpus-fixtures": "node --import tsx ./scripts/build-v2-regulatory-gold-corpus-stage3-fixtures.ts --fail-on-missing",
    "v2:regulatory-confidence-calibration": "node --import tsx ./scripts/analyze-v2-regulatory-confidence.ts",
    "v2:regulatory-status-gaps": "node --import tsx ./scripts/analyze-v2-regulatory-status-gaps.ts --write-summary",
    "v2:regulatory-lane-quality": "node --import tsx ./scripts/verify-v2-regulatory-lane-quality.ts --write-summary",
    "v2:regulatory-gold-corpus-refresh": "node --import tsx ./scripts/build-v2-regulatory-gold-corpus-stage1.ts && node --import tsx ./scripts/build-v2-regulatory-gold-corpus-stage2.ts && pnpm v2:regulatory-gold-corpus-verify",
    "v2:regulatory-gold-corpus-verify": "node --import tsx ./scripts/verify-v2-regulatory-gold-corpus-stage2.ts",
    "v2:endpoint-enrichment-registry": "pnpm --filter @certscore/contracts build && pnpm --filter @certscore/vendor-resolver build && node --import tsx ./scripts/enrich-v2-endpoint-registry.ts",
    "v2:endpoint-enrichment-cron": "pnpm v2:endpoint-enrichment-registry -- --artifact-root artifacts --write-overlays --timeout-ms 500 --max-hosts 250",
    "v2:replay-pilot": "pnpm tsx scripts/run-wc01-v2-scan-lab-cohort.ts --urls artifacts/v2-cmp-reject-reliability-expansion/pilot-10-urls.txt --profile full --limit 10 --capture-replay --out-dir artifacts/v2-cmp-reject-reliability-replay-pilot && pnpm v2:replay --corpus artifacts/v2-cmp-reject-reliability-replay-pilot --out artifacts/v2-cmp-reject-reliability-replay-pilot-validation && pnpm v2:replay --corpus artifacts/v2-cmp-reject-reliability-replay-pilot --mode evidence --out artifacts/v2-cmp-reject-reliability-replay-pilot-evidence",
    "v2:calibrate": "pnpm --filter @certscore/scan-core build && PLAYWRIGHT_BROWSERS_PATH= node --env-file=apps/web/.env.local --import tsx ./packages/certscore-scan-core/src/cli/calibrate.ts",
    "dev:safe": "NODE_OPTIONS='--max-old-space-size=2048' turbo run dev --parallel",
    "scan:safe": "PLAYWRIGHT_WORKERS=1 NODE_OPTIONS='--max-old-space-size=4096' pnpm --filter @website-signal-risk-scanner/validation-worker test:scan-pipeline",
    "vscode:light": "code --disable-extensions .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.27.3",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
