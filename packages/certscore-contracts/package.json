{
  "name": "@certscore/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "CertScore v2 scanner and review contracts.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --tsconfig ../../tsconfig.base.json --test 'src/*.test.ts'",
    "test:fixtures": "tsx --tsconfig ../../tsconfig.base.json --test src/saved-bundle-fixtures.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
