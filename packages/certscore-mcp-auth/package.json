{
  "name": "@certscore/mcp-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Shared OAuth and bearer-token helpers for CertScore MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
