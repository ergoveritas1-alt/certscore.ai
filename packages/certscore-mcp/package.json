{
  "name": "@certscore/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for CertScore Pulse.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "certscore-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "prepack": "pnpm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "certscore",
    "pulse",
    "mcp",
    "model-context-protocol"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@certscore/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  }
}
