{
  "name": "@certscore/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the CertScore Pulse API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergoveritas1-alt/certscore.ai.git",
    "directory": "packages/certscore-sdk"
  },
  "homepage": "https://certscore.ai/developers/sdk",
  "bugs": {
    "url": "https://certscore.ai/contact",
    "email": "support@certscore.ai"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "prepack": "pnpm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "certscore",
    "pulse",
    "privacy",
    "consent",
    "runtime-analysis"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@certscore/api-contracts": "workspace:*"
  }
}
