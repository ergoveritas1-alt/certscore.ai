{
  "name": "@certscore/vendor-resolver",
  "version": "0.1.0",
  "private": true,
  "description": "High-confidence CertScore v2 vendor and product resolver.",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm --filter @certscore/contracts build && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "tsx --tsconfig ../../tsconfig.base.json --test 'src/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@certscore/contracts": "workspace:*",
    "@iabgpp/cmpapi": "3.2.0",
    "acorn": "8.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime-script-facts": {
      "types": "./dist/runtime-script-facts.d.ts",
      "default": "./dist/runtime-script-facts.js"
    },
    "./property-sale-sharing": {
      "types": "./dist/property-sale-sharing.d.ts",
      "default": "./dist/property-sale-sharing.js"
    }
  },
  "typesVersions": {
    "*": {
      "runtime-script-facts": [
        "dist/runtime-script-facts.d.ts"
      ],
      "property-sale-sharing": [
        "dist/property-sale-sharing.d.ts"
      ]
    }
  }
}
