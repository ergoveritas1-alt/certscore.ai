{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "moduleDetection": "force",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@website-signal-risk-scanner/shared": ["packages/shared/src"],
      "@website-signal-risk-scanner/web-bot-auth": ["packages/web-bot-auth/src"],
      "@website-signal-risk-scanner/validation-shared": ["packages/validation-shared/src"],
      "@website-signal-risk-scanner/db": ["packages/db/src"],
      "@website-signal-risk-scanner/ui": ["packages/ui/src"]
    }
  }
}
