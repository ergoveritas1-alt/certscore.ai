{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["NODE_OPTIONS"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "passThroughEnv": ["CERTSCORE_VERIFIED_TYPECHECK_EXPORTS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/prepare-typecheck-deps.ts",
        "$TURBO_ROOT$/scripts/lib/release-bootstrap.ts",
        "$TURBO_ROOT$/scripts/lib/release-suite-reuse.ts"
      ],
      "outputs": []
    },
    "test:policy:fast": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/certscore-contracts/src/**",
        "$TURBO_ROOT$/packages/certscore-vendor-resolver/src/**",
        "$TURBO_ROOT$/packages/shared/src/**",
        "$TURBO_ROOT$/packages/web-bot-auth/src/**"
      ],
      "outputs": []
    },
    "test:policy:full": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/certscore-contracts/src/**",
        "$TURBO_ROOT$/packages/certscore-vendor-resolver/src/**",
        "$TURBO_ROOT$/packages/shared/src/**",
        "$TURBO_ROOT$/packages/web-bot-auth/src/**"
      ],
      "outputs": []
    },
    "test:policy:timing-canary": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
